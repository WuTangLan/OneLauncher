<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline edge always; a soft light sheen across the top when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="14dp" />
                    <gradient android:angle="270" android:type="linear"
                        android:startColor="#38FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#59FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
