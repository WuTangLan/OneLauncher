<?xml version="1.0" encoding="utf-8"?>
<!-- A 5:3 tile. The name appears underneath while focused, like tvOS. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="18dp"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/tile_card"
        android:layout_width="140dp"
        android:layout_height="84dp"
        android:background="@drawable/tile_bg"
        android:duplicateParentState="true"
        android:foreground="@drawable/tile_fg">

        <ImageView
            android:id="@+id/tile_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tile_iconbox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/tile_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tile_icon_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tile_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/pill_off"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="7dp"
            android:paddingTop="1dp"
            android:paddingEnd="7dp"
            android:paddingBottom="1dp"
            android:text="Get"
            android:textColor="#FF0A84FF"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tile_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:visibility="invisible" />
</LinearLayout>
