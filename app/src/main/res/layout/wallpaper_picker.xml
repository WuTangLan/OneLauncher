<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet over the home screen. Moving between thumbnails previews the wallpaper live. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/picker_panel"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="76dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Wallpaper"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/picker_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="48dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#99EBEBF5"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingEnd="96dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/picker_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingStart="12dp" />
    </HorizontalScrollView>
</LinearLayout>
