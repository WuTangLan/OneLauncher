<resources>
    <!-- Sentence case, quiet secondary text -->
    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#8CEBEBF5</item>
        <item name="android:textSize">13sp</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <!-- Clock and temperature -->
    <style name="HeaderBig">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">34sp</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <!-- Date and weather condition -->
    <style name="HeaderSmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#99EBEBF5</item>
        <item name="android:textSize">12sp</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <!-- High / low -->
    <style name="HeaderTiny">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#99EBEBF5</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Padding gives focused tiles room to lift without clipping -->
    <style name="RowScroll">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:scrollbars">none</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">48dp</item>
    </style>

    <style name="Row">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clipChildren">false</item>
    </style>

    <!-- Glass widget card -->
    <style name="Card">
        <item name="android:layout_height">62dp</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CardLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#99EBEBF5</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
